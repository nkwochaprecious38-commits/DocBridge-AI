# Supabase (required for authentication, database and storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI (server only). Enables summaries, classification, extraction, OCR for images and scanned PDFs, chat, comparison, splitting.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: LlamaParse for legacy formats (DOC, XLS, PPT) and higher fidelity parsing
LLAMA_CLOUD_API_KEY=

# Public site URL used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
